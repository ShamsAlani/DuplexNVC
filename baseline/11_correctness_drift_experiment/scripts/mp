#!/bin/bash
# MULTI-PERSON DRIFT CHECK (~1.5 h, normal Mac, charger in, lid open). Step 5's main structure on the 11 Step 8 clips
# for B*, MLVC-S 540p and MLVC-S 720p; then the Step 5 analysis on these clips. RESUMABLE.
# Needs the 11 masters from the team Drive folder step8_masters/ (downloaded anywhere under ~/Downloads).
# Output: ~/Downloads/duplexnvc-baseline/phase2/5m/ (results/ = same tables as Step 5) ; console: out_mp.txt
D=$(cd "$(dirname "$0")" && pwd); . "$D/../v"; exec > >(tee -a "$D/out_mp.txt") 2>&1
echo; echo "== multi-person drift check START  $(date)"; pmset -g batt | head -1
f=$(find ~/Downloads -maxdepth 4 -name 'pxleav_1920x1080_30.mp4' -not -path '*/duplexnvc-baseline/*' 2>/dev/null | head -1)
[ -n "$f" ] || { echo "== step8_masters not found under ~/Downloads: download the folder from the team Drive first"; exit 1; }
SRC=$(dirname "$f"); echo "   masters: $SRC"
n=0; for i in ce4peo cejohn cekris px2ent px4ppl px5ppl px7ppl pxcrwd pxdown pxentr pxleav; do
  ls "$SRC/${i}_"*_30.mp4 >/dev/null 2>&1 && n=$((n+1)) || echo "   MISSING $i"; done
echo "   masters present: $n of 11"; [ $n = 11 ] || exit 1
for pass in 1 2; do caffeinate -ims "$PY" -u "$D/m.py" "$SRC"; done
echo; echo "== analysis  $(date)"
S5OUT="$WORK/phase2/5m" "$PY" "$D/ana.py"
cp "$D/out_mp.txt" "$WORK/phase2/5m/results/" 2>/dev/null
echo "VCD (20 clips) for comparison: phase2/5/results/summary.txt"
echo "== multi-person drift check END  $(date)"
