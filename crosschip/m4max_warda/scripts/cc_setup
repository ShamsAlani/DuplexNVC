#!/bin/bash
# ONE-TIME SETUP on a second Mac (Warda's M4 Pro, Mohammed's M1). Safe to run again: it skips what is done.
#     bash ~/DuplexNVC/crosschip/m4max_warda/scripts/cc_setup
# Needs: Wi-Fi on, the charger in, and ~/Downloads/cc_pack_shams.zip (from Shams, via Drive).
# About 20-40 min the first time (downloads and builds). Asks for your Mac password once (Homebrew).
# No model conversion: the Core ML bundles come from Shams's Mac, so every Mac runs the same models.
D=$(cd "$(dirname "$0")" && pwd); REPO=$(cd "$D" && while [ ! -d baseline ] && [ "$PWD" != / ]; do cd ..; done; pwd)
S="$REPO/baseline/common/scripts"; [ -f "$S/settings.sh" ] && . "$S/settings.sh" || . "$S/v"; [ -f "$S/settings_phase2.sh" ] && . "$S/settings_phase2.sh" || . "$S/s2cfg"
mkdir -p "$WORK"/{tools,bundles,data/nv12,data/incoming,runs,crosschip} "$MP4"
exec > >(tee -a "$WORK/crosschip/setup_log.txt") 2>&1
echo "== cc_setup  $(date)  $(sysctl -n machdep.cpu.brand_string)"
step () { echo; echo "[$1] $2"; }
stop () { echo; echo "STOPPED: $1"; exit 1; }

step 1 "Command Line Tools"
xcode-select -p >/dev/null 2>&1 || { xcode-select --install; stop "a window opened: click Install, wait until it finishes, then run this script again."; }
echo "   ok"

step 2 "Homebrew and tools (cmake, ninja, git-lfs, ffmpeg, python 3.12)"
[ -x /opt/homebrew/bin/brew ] || NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
[ -x /opt/homebrew/bin/brew ] || stop "Homebrew install failed (see above)." 
eval "$(/opt/homebrew/bin/brew shellenv)"
for p in cmake ninja git-lfs ffmpeg python@3.12; do brew list $p >/dev/null 2>&1 || brew install $p; done
git lfs install >/dev/null; echo "   ok"

step 3 "Python environment (numpy only; no torch needed here)"
if [ ! -x "$PY" ]; then
  for p in /opt/homebrew/bin/python3.12 /opt/homebrew/bin/python3.13 /opt/homebrew/bin/python3 /usr/bin/python3; do
    [ -x $p ] && $p -m venv "$WORK/.venv" && echo "   venv made with $p" && break
  done
fi
[ -x "$PY" ] || stop "could not make the Python environment."
"$PY" -c "import numpy" 2>/dev/null || "$WORK/.venv/bin/pip" install -q numpy
"$PY" -c "import numpy; print('   numpy', numpy.__version__)"

step 4 "libmlvc at commit eb5d60a"
if [ ! -x "$MLVC" ]; then
  cd "$WORK"; [ -d libmlvc/.git ] || GIT_LFS_SKIP_SMUDGE=1 git clone https://github.com/microsoft/libmlvc.git
  cd libmlvc && git checkout -q eb5d60a && git lfs pull || stop "libmlvc download failed (Wi-Fi?). Run again."
  cmake --preset mac-arm64-ninja-release >/dev/null && cmake --build --preset mac-arm64-ninja-release | tail -2 \
    && cmake --install build/mac-arm64-ninja-release >/dev/null || stop "libmlvc build failed (see above)."
fi
git -C "$WORK/libmlvc" rev-parse --short HEAD > "$WORK/LIBMLVC_COMMIT.txt"; echo "   commit $(cat "$WORK/LIBMLVC_COMMIT.txt") (must be eb5d60a)"

step 5 "measurement program (duplex_bench) and tools"
cp "$REPO"/baseline/common/code/* "$TOOLS/"
if [ ! -d "$WORK/harness" ]; then cp -R "$WORK/libmlvc/examples/minimal-fetchcontent" "$WORK/harness"; fi
cp "$REPO/baseline/common/scripts/main.cpp" "$WORK/harness/main.cpp"
cd "$WORK/harness"
[ -f build/ninja-release/build.ninja ] || cmake -S . -B build/ninja-release -G Ninja -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_OSX_ARCHITECTURES=arm64 -DBUILD_SHARED_LIBS=OFF -DFETCHCONTENT_SOURCE_DIR_LIBMLVC="$WORK/libmlvc" >/dev/null
cmake --build build/ninja-release | tail -1
echo "   fixed-version check (must be 13): $(grep -c 'Clock::now()' "$WORK/harness/main.cpp")"
swiftc -O "$TOOLS/thermal_log.swift" -o "$TOOLS/thermal_log" 2>/dev/null && echo "   thermal_log ok"
clang -O2 -o "$TOOLS/bwload" "$D/bwload.c" -lpthread && echo "   bwload ok"

step 6 "Shams's pack: bundles, incoming streams, source clips, reference MD5s"
PK=~/Downloads/cc_pack_shams
[ -d "$PK" ] || { [ -f ~/Downloads/cc_pack_shams.zip ] && (cd ~/Downloads && unzip -q -o cc_pack_shams.zip); }
[ -d "$PK" ] || stop "~/Downloads/cc_pack_shams.zip not found. Download it from the Drive folder into Downloads, then run again."
rsync -a "$PK/bundles/" "$WORK/bundles/"; ls "$WORK/bundles" | sed 's/^/   bundle /'
rsync -a "$PK/incoming/" "$WORK/data/incoming/"
cp "$PK"/mp4/*.mp4 "$MP4/"
mkdir -p "$WORK/crosschip/ref"; cp -R "$PK/ref_md5" "$PK/nv12_md5.txt" "$PK"/specs_*.txt "$WORK/crosschip/ref/" 2>/dev/null
[ -s "$PK/bstar/outgoing.mlvc" ] && cp "$PK/bstar/outgoing.mlvc" "$WORK/crosschip/ref/bstar_outgoing.mlvc"
echo "   Shams's libmlvc commit: $(cat "$PK/LIBMLVC_COMMIT.txt" 2>/dev/null)"

step 7 "raw camera and incoming streams (same clips as B*), checked against Shams's MD5s"
[ -s "$CAM" ] || gunzip -c "$CLIPS/VCD_s1_0380a3_640x360_30fps.nv12.gz" "$CLIPS/VCD_s1_6587ae_640x360_30fps.nv12.gz" > "$CAM"
[ -s "$INCSRC" ] || gunzip -c "$CLIPS/VCD_s1_6c9c96_640x360_30fps.nv12.gz" "$CLIPS/VCD_s1_9c02f6_640x360_30fps.nv12.gz" > "$INCSRC"
mk () {  # same as baseline 08 script 2b
  local out=$1 wh=$2; shift 2; [ -s "$out" ] && return
  for id in "$@"; do ffmpeg -v error -i "$MP4/${id}_1920x1080_30.mp4" -frames:v 300 -vf "scale=${wh/x/:}:flags=lanczos" -pix_fmt nv12 -f rawvideo -; done > "$out"
}
for wh in 960x540:540p 1280x720:720p 1920x1080:1080p; do
  mk "$NV/cam_${wh#*:}.nv12" ${wh%:*} $CAMIDS; mk "$NV/incsrc_${wh#*:}.nv12" ${wh%:*} $INCIDS
done
SAME=0; DIFF=0
for f in "$CAM" "$INCSRC" "$NV"/cam_*.nv12 "$NV"/incsrc_*.nv12; do
  ref=$(grep " $(basename "$f")$" "$WORK/crosschip/ref/nv12_md5.txt" 2>/dev/null | cut -d' ' -f1)
  if [ "$(md5 -q "$f")" = "$ref" ]; then SAME=$((SAME+1)); else DIFF=$((DIFF+1)); echo "   differs from Shams: $(basename "$f")"; fi
done
echo "   streams identical to Shams's: $SAME, different: $DIFF"
[ $DIFF -gt 0 ] && echo "   (a different ffmpeg version can change the scaled streams slightly; timing is not affected, but note it)"

step 8 "smoke test: full MLVC 360p, encoder and decoder on the NE, 5 s"
"$BENCH" duplex $BL --fps 30 --seconds 5 --out-dir /tmp/cc_smoke 2> /tmp/cc_smoke.log
grep -oE "requested=[a-z]+ resolved=[a-z]+" /tmp/cc_smoke.log | sort -u | sed 's/^/   /'
grep -qE "FAILED|rror" /tmp/cc_smoke.log && stop "smoke test failed: see /tmp/cc_smoke.log"
[ -s /tmp/cc_smoke/frames.csv ] || stop "smoke test wrote no frames: see /tmp/cc_smoke.log"
"$PY" "$TOOLS/analyze_run.py" timing /tmp/cc_smoke | tail -2

echo; echo "== SETUP DONE. Next, the night run:  bash $D/cc_all"
