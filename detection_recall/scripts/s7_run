#!/bin/bash
# STEP 7 DETECTION RECALL, one command, on the Mac that made Step 8 (Warda's M1). About 5 min. No password.
#     bash ~/DuplexNVC/detection_recall/scripts/s7_run
# Runs s7_recall.py, copies the results into the repo (detection_recall/) and pushes them to GitHub.
D=$(cd "$(dirname "$0")" && pwd); REPO=$(cd "$D/../.." && pwd); OUT="$REPO/detection_recall"
WORK=~/Downloads/duplexnvc-baseline; PY=$WORK/.venv/bin/python; S7=$WORK/phase2/step7
eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null)"
stop () { echo; echo "STOPPED: $*"; exit 1; }
mkdir -p "$S7"
echo "== Step 7 detection recall  $(date)"
[ -x "$PY" ] || stop "Python environment missing ($PY): this must run on the Mac that made Step 8."
"$PY" -c "import cv2" 2>/dev/null || "$WORK/.venv/bin/pip" -q install opencv-python-headless numpy
[ -x "$WORK/tools/facebox" ] || stop "facebox missing ($WORK/tools/facebox): this must run on the Mac that made Step 8."
command -v ffmpeg >/dev/null || stop "ffmpeg missing."
"$PY" "$D/s7_recall.py" | tee "$S7/out_s7.txt"; [ "${PIPESTATUS[0]}" = 0 ] || stop "the recall script failed (see above)."

echo; echo "== copying into the repo"
mkdir -p "$OUT/results/check" "$OUT/raw_data/faces"
cp "$S7"/results/*.csv "$OUT/results/"; cp "$S7"/results/check/*.jpg "$OUT/results/check/"
cp "$S7"/faces/*.json "$OUT/raw_data/faces/"; cp "$S7/out_s7.txt" "$OUT/raw_data/"
{ system_profiler SPHardwareDataType | grep -E "Model Name|Model Identifier|Chip|Total Number of Cores|Memory"; sw_vers; } > "$OUT/raw_data/machine.txt"
echo "   $(ls "$OUT/results" | wc -l | tr -d ' ') result files, $(ls "$OUT/raw_data/faces" | wc -l | tr -d ' ') face files"

echo; echo "== pushing to GitHub"
cd "$REPO" && git pull -q origin main && git add detection_recall && git commit -q -m "Step 7: detection recall by face size and resolution" \
  && git push -q origin main && echo "   pushed: detection_recall/" || echo "   NOT pushed: copy the lines above to the chat"
echo; echo "== DONE. Paste everything from 'Detection recall by face size' to the chat."
